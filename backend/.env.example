# App
APP_NAME=your-no-space-application-name
DEBUG=True
FRONTEND_URL=your-frontend-url


# MongoDB
# Example Atlas:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/mangaai
MONGO_URI=mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=db-name

# JWT
JWT_SECRET_KEY=replace-with-secure-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=url/google/callback

# Gemini API
GEMINI_API_KEY=your_gemini_api_key

# Weights & Biases (Weave) - For tracking AI model usage
WANDB_API_KEY=your_wandb_api_key
WANDB_PROJECT_NAME=ramen-art
WANDB_ENTITY=your_wandb_username

# Z-Image (HuggingFace / Gradio)
Z_IMAGE_MODEL=Tongyi-MAI/Z-Image-Turbo
Z_IMAGE_DEFAULT_RESOLUTION=1024x1024 ( 1:1 )
Z_IMAGE_DEFAULT_STEPS=8
Z_IMAGE_DEFAULT_SHIFT=3
Z_IMAGE_DEFAULT_SEED=4

HF_TOKEN=
# Optional (future-proof)

# Cloudinary (Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret